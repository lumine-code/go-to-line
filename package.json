{
  "name": "go-to-line",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Jump the cursor to a specific line number.",
  "keywords": [
    "navigation",
    "jump",
    "cursor",
    "number",
    "location"
  ],
  "repository": "https://github.com/lumine-code/go-to-line",
  "bugs": {
    "url": "https://github.com/lumine-code/go-to-line/issues"
  },
  "license": "MIT",
  "main": "./lib/go-to-line-view",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can jump straight to a line number with {{ 'go-to-line:toggle' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "lumine-text-editor": [
      "go-to-line:toggle"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
